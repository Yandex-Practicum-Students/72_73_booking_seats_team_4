# app settings
TITLE=<Название приложения>
DESCRIPTION=<Описание приложения>
VERSION=0.0.3
ENVIRONMENT=<Среда разработки>    # development production
TZ=<Временная зона>   # Europe/Moscow


# logging settings
LOG_LEVEL=<Уровень логирования>
LOG_FILE_PATH=<адрес файла для логов>
LOG_ROTATION_SIZE_MB=<Максимальный размер файла логов>
LOG_RETENTION_COUNT=<Количество хранимых архивных логов>

# Postgresql database connection
POSTGRES_USER=<Имя пользователя>
POSTGRES_PASSWORD=<Пароль пользователя>
POSTGRES_DB=<Название базы данных>
POSTGRES_SERVER=<Название или IP сервера базы данных>
POSTGRES_PORT=<Порт базы данных>

# RabbitMQ and Celery
RABBITMQ_USER=<Имя пользователя RabbitMQ>
RABBITMQ_PASSWORD=<Пароль пользователя RabbitMQ>
RABBITMQ_SERVER=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
CELERY_TASK_DEFAULT_QUEUE=booking_notifications
CELERY_BROKER_HEARTBEAT=30

# Flower monitoring
FLOWER_BASIC_AUTH=<Имя пользователя Flower>:<Пароль Flower>

# CORS
ALLOWED_HOSTS=http://localhost:3000 http://localhost:5173 http://127.0.0.1:3000 http://127.0.0.1:5173
ALLOW_CREDENTIALS=true
ALLOWED_METHODS=GET POST PUT DELETE OPTIONS PATCH
ALLOWED_HEADERS=Authorization Content-Type Accept X-Request-ID

# JWT authorization
JWT_SECRET=<Не менее 32 случайных символов для подписи JWT-токенов>
JWT_LIFETIME_SECONDS=3600

# REDIS
REDIS_PASSWORD=<Пароль пользователя сервера>
REDIS_PORT=<Порт сервера redis>
REDIS_URL=<адрес сервера redis>
MAX_CONNECTIONS=<Количество доступных соединений redis>
DECODE_RESPONSES=<декодировать ли ответ от редис в строку>
REDIS_CACHE_EXPIRE_SECONDS=<время жизни объекта в редис>
